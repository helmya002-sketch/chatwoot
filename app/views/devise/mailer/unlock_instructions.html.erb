<%# Tolzar (round 4, c83): with TOLZAR_NEW_EMAILS=true this mail uses the same card as the confirmation and
    invitation mails (heading, short copy, a Tolzar button and a fallback link); otherwise it is unchanged. %>
<% if ENV['TOLZAR_NEW_EMAILS'] == 'true' %>
<%= render partial: 'devise/mailer/confirmation_body', locals: {
  eyebrow: 'Security',
  heading: 'Your account was locked',
  intro_text: 'We locked your account after too many unsuccessful sign-in attempts.',
  supporting_text: 'Use the button below to unlock it, then sign in as usual.',
  action_text: 'Unlock my account',
  action_url: unlock_url(@resource, unlock_token: @token),
  info_text: nil,
  info_title: nil,
  detail_rows: [],
  recipient_name: @resource.name.presence || @resource.email
} %>
<% else %>
<p>Hello <%= @resource.email %>!</p>

<p>Your account has been locked due to an excessive number of unsuccessful sign in attempts.</p>

<p>Click the link below to unlock your account:</p>

<p><%= link_to 'Unlock my account', unlock_url(@resource, unlock_token: @token) %></p>
<% end %>
