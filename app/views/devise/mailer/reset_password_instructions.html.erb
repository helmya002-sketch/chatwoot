<%# Tolzar (round 4, c83): with TOLZAR_NEW_EMAILS=true this mail uses the same card as the confirmation and
    invitation mails (heading, short copy, a Tolzar button and a fallback link); otherwise it is unchanged. %>
<% if ENV['TOLZAR_NEW_EMAILS'] == 'true' %>
<%
  reset_params = { reset_password_token: @token }
  reset_params[:route_url] = params[:redirect_url] if params[:redirect_url].present?
  reset_params[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present?
%>
<%= render partial: 'devise/mailer/confirmation_body', locals: {
  eyebrow: 'Password',
  heading: 'Choose a new password',
  intro_text: 'Someone asked for a link to change the password on your account.',
  supporting_text: "If this wasn't you, you can ignore this email: your password stays the same until you set a new one.",
  action_text: 'Change my password',
  action_url: frontend_url('auth/password/edit', **reset_params),
  info_text: nil,
  info_title: nil,
  detail_rows: [],
  recipient_name: @resource.name.presence || @resource.email
} %>
<% else %>
<p>Hello <%= @resource.email %>!</p>

<p>Someone has requested a link to change your password. You can do this through the link below.</p>

<% reset_password_params = { reset_password_token: @token } %>
<% reset_password_params[:route_url] = params[:redirect_url] if params[:redirect_url].present? %>
<% reset_password_params[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present? %>
<p><%= link_to 'Change my password', frontend_url('auth/password/edit', **reset_password_params) %></p>

<p>If you didn't request this, please ignore this email.</p>
<p>Your password won't change until you access the link above and create a new one.</p>
<% end %>
