<p>Hello,</p>

<p>Here is <b>{{ meta['workspace'] }}</b> from {{ meta['from'] }} to {{ meta['to'] }}.</p>

<p style="margin: 16px 0 6px; font-weight: 700;">Your team</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border: 1px solid #DCE7F5; border-radius: 16px; background-color: #F8FBFF; margin: 0 0 16px;">
  <tr><td style="padding: 8px 16px; color: #64748B;">Person</td><td style="padding: 8px 16px; color: #64748B; text-align: right;">Replies</td><td style="padding: 8px 16px; color: #64748B; text-align: right;">First reply</td><td style="padding: 8px 16px; color: #64748B; text-align: right;">Resolved</td></tr>
  {% for p in meta['people'] %}
  <tr><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0;">{{ p['name'] }}</td><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0; text-align: right; font-weight: 700;">{{ p['replies'] }}</td><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0; text-align: right;">{{ p['first_reply'] }}</td><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0; text-align: right; font-weight: 700;">{{ p['resolved'] }}</td></tr>
  {% endfor %}
</table>

<p style="margin: 16px 0 6px; font-weight: 700;">Your channels</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border: 1px solid #DCE7F5; border-radius: 16px; background-color: #F8FBFF; margin: 0 0 16px;">
  <tr><td style="padding: 8px 16px; color: #64748B;">Inbox</td><td style="padding: 8px 16px; color: #64748B; text-align: right;">Conversations</td><td style="padding: 8px 16px; color: #64748B; text-align: right;">Customer messages</td><td style="padding: 8px 16px; color: #64748B; text-align: right;">First reply</td></tr>
  {% for i in meta['inboxes'] %}
  <tr><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0;">{{ i['name'] }}</td><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0; text-align: right; font-weight: 700;">{{ i['conversations'] }}</td><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0; text-align: right;">{{ i['incoming'] }}</td><td style="padding: 8px 16px; border-top: 1px solid #E2E8F0; text-align: right;">{{ i['first_reply'] }}</td></tr>
  {% endfor %}
</table>

<p><a href="{{ action_url }}">Open Results</a></p>
