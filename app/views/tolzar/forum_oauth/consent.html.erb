<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <%= csrf_meta_tags %>
  <title><%= t("tolzar.forum_oauth.title") %></title>
</head>
<body style="margin:0;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:#f6f7f9;color:#1c2024;">
  <main style="max-width:480px;margin:64px auto;padding:28px;background:#fff;border-radius:8px;">
    <h1 style="font-size:20px;margin:0 0 12px;"><%= t("tolzar.forum_oauth.title") %></h1>
    <p style="margin:0 0 6px;"><%= t("tolzar.forum_oauth.consent.text", name: @user.display_name.presence || @user.name) %></p>
    <p style="margin:0 0 20px;color:#60646c;font-size:14px;"><%= t("tolzar.forum_oauth.consent.shared") %></p>
    <%= form_with url: tolzar_oauth_authorize_path, method: :post, local: true do |f| %>
      <% %w[response_type client_id redirect_uri state code_challenge code_challenge_method].each do |key| %>
        <%= hidden_field_tag key, params[key] if params[key].present? %>
      <% end %>
      <%= f.submit t("tolzar.forum_oauth.consent.button"),
                   style: "background:#1c2024;color:#fff;border:0;border-radius:6px;padding:10px 16px;font-size:15px;cursor:pointer;" %>
    <% end %>
  </main>
</body>
</html>
