<!doctype html>
<html lang="<%= @locale %>" dir="<%= @locale == 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t('tolzar.feedback.mail.shipped.subject', title: @idea.title) %></title>
</head>
<body style="margin:0;padding:24px 12px;background:#f6f7f9;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1c2024;">
  <div style="max-width:560px;margin:0 auto;padding:28px;background:#ffffff;border-radius:8px;font-size:16px;line-height:1.55;">
    <p style="margin:0 0 16px;"><%= t('tolzar.feedback.mail.shipped.intro', title: @idea.title) %></p>
    <% if @explanation.present? %>
      <div style="margin:0 0 16px;padding:12px 16px;background:#f0f4ff;border-radius:6px;"><%= simple_format(h(@explanation), {}, wrapper_tag: 'div') %></div>
    <% end %>
    <p style="margin:0 0 8px;"><a href="<%= @idea_url %>" style="color:#1d4ed8;"><%= t('tolzar.feedback.mail.see_idea') %></a></p>
    <% if @changelog_url %>
      <p style="margin:0 0 8px;"><a href="<%= @changelog_url %>" style="color:#1d4ed8;"><%= t('tolzar.feedback.mail.shipped.changelog') %></a></p>
    <% end %>
    <div style="margin-top:24px;padding-top:16px;border-top:1px solid #e8e8ec;font-size:12px;color:#60646c;">
      <p style="margin:0 0 8px;"><%= t('tolzar.feedback.mail.why') %></p>
      <p style="margin:0 0 8px;"><a href="<%= @unsubscribe_url %>" style="color:#60646c;"><%= t('tolzar.newsletter.footer.unsubscribe') %></a></p>
      <p style="margin:0;"><%= @postal_address %></p>
    </div>
  </div>
</body>
</html>
