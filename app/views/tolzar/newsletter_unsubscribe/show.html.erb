<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= t('tolzar.newsletter.unsubscribe.title') %></title>
</head>
<body style="margin:0;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:#f6f7f9;color:#1c2024;">
  <main style="max-width:480px;margin:64px auto;padding:28px;background:#fff;border-radius:8px;">
    <h1 style="font-size:20px;margin:0 0 12px;"><%= t('tolzar.newsletter.unsubscribe.title') %></h1>
    <% if @done %>
      <p style="margin:0;"><%= t('tolzar.newsletter.unsubscribe.done') %></p>
    <% else %>
      <p style="margin:0 0 20px;"><%= t('tolzar.newsletter.unsubscribe.confirm') %></p>
      <%= form_with url: tolzar_newsletter_unsubscribe_path(token: params[:token]), method: :post, local: true do |f| %>
        <%= f.submit t('tolzar.newsletter.unsubscribe.button'),
                     style: 'background:#1c2024;color:#fff;border:0;border-radius:6px;padding:10px 16px;font-size:15px;cursor:pointer;' %>
      <% end %>
    <% end %>
  </main>
</body>
</html>
