<%
  version = Chatwoot.config[:version]
  # Internal::CheckNewVersionsJob keeps the newest release here.
  latest_version = begin
    Redis::Alfred.get(Redis::Alfred::LATEST_CHATWOOT_VERSION).presence
  rescue Redis::BaseConnectionError
    nil
  end
  update_available = latest_version && Gem::Version.new(latest_version) > Gem::Version.new(version)
%>
<div class="flex h-14 shrink-0 items-center gap-3">
  <%# Tolzar: inline SVG mark (brand-assets are served 1-year immutable, so an
      <img> would keep showing a stale/old logo after a rebrand). %>
  <%= link_to super_admin_root_path, class: "shrink-0", tabindex: -1, aria: { hidden: true } do %>
    <svg class="size-8" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <rect width="32" height="32" rx="8" fill="#12A594"/>
      <path d="M9 10.5h14v3.2h-5.4V23h-3.2v-9.3H9z" fill="#ffffff"/>
    </svg>
  <% end %>
  <div class="min-w-0 whitespace-nowrap">
    <div class="flex items-baseline gap-1.5 leading-5">
      <%= link_to "Tolzar", super_admin_root_path, class: "text-sm font-medium text-n-slate-12" %>
      <span class="text-label-small tabular-nums text-n-slate-10">v1.0</span>
    </div>
    <div class="text-label-small leading-4 text-n-slate-10"><%= t("super_admin.navigation.suffix") %></div>
  </div>
</div>
