<%# locals: (rows:, actions: false) -%>
<% cc = "super_admin.control_center" %>
<% if rows.empty? %>
  <p class="px-5 py-4 text-body-main text-n-slate-11"><%= t("#{cc}.none") %></p>
<% else %>
  <div class="overflow-x-auto">
    <table class="w-full text-start text-body-main">
      <thead class="text-label-small text-n-slate-11">
        <tr class="border-b border-n-weak">
          <% %w[person roles twofa last_sign_in].each do |col| %>
            <th class="px-4 py-2 text-start font-medium"><%= t("#{cc}.col.#{col}") %></th>
          <% end %>
          <% if actions %><th class="px-4 py-2 text-start font-medium"><%= t("#{cc}.people_actions") %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr class="border-b border-n-weak align-top">
            <td class="px-4 py-2">
              <div class="text-n-slate-12"><%= row[:name] %></div>
              <div class="text-xs text-n-slate-11"><%= row[:email] %></div>
            </td>
            <td class="px-4 py-2">
              <div class="flex flex-wrap gap-1">
                <%= render "badge", label: t("#{cc}.super_admin"), tone: :accent if row[:super_admin] %>
                <% Array(row[:roles]).each do |r| %>
                  <%= render "badge", label: [r[:account], r[:role].to_s.humanize].compact.join(": "),
                                      tone: (r[:role].to_s == "administrator" ? :info : :neutral) %>
                <% end %>
              </div>
            </td>
            <td class="px-4 py-2">
              <% if row[:mfa] %>
                <%= render "badge", label: t("#{cc}.twofa_on"), tone: :success %>
              <% else %>
                <%= render "badge", label: t("#{cc}.twofa_off"), tone: (row[:admin] || row[:role].to_s == "administrator" ? :danger : :warning) %>
              <% end %>
            </td>
            <td class="px-4 py-2 font-mono text-xs text-n-slate-11"><%= row[:last_sign_in_at]&.utc&.strftime("%Y-%m-%d %H:%M") || "–" %></td>
            <% if actions && row[:user] %>
              <td class="px-4 py-2">
                <details>
                  <summary class="cursor-pointer text-n-blue-11"><%= t("#{cc}.people_actions") %></summary>
                  <%= form_with url: super_admin_tolzar_cc_reset_two_factor_path(row[:user].id), method: :post,
                                class: "mt-2 flex flex-col gap-2 w-64" do %>
                    <%= label_tag "confirm-#{row[:user].id}", t("#{cc}.people_confirm"), class: "text-label-small" %>
                    <%= text_field_tag :confirm, nil, id: "confirm-#{row[:user].id}", autocomplete: "off", class: ui(:input, "min-h-9") %>
                    <%= label_tag "reason-#{row[:user].id}", t("#{cc}.people_reason"), class: "text-label-small" %>
                    <%= text_field_tag :reason, nil, id: "reason-#{row[:user].id}", maxlength: 300, class: ui(:input, "min-h-9") %>
                    <div class="flex flex-wrap gap-1.5">
                      <% { reset_two_factor: :super_admin_tolzar_cc_reset_two_factor_path, end_sessions: :super_admin_tolzar_cc_end_sessions_path,
                           resend_invite: :super_admin_tolzar_cc_resend_invite_path }.each do |key, route| %>
                        <%= button_tag t("#{cc}.people_action.#{key}"), type: "submit", formaction: send(route, row[:user].id),
                                       class: "h-8 px-2.5 rounded-lg border border-n-slate-6 text-label-small hover:bg-n-slate-3" %>
                      <% end %>
                    </div>
                  <% end %>
                </details>
              </td>
            <% elsif actions %>
              <td></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
