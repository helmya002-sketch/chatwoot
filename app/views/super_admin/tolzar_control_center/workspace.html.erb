<% content_for(:title) { @account.name } %>
<% cc = "super_admin.control_center" %>
<% sub = @detail[:subscription] %>

<%= render "section", title: @account.name, description: t("#{cc}.workspace_description", id: @account.id), icon: "i-lucide-building-2" do %>
  <div class="flex flex-wrap gap-2">
    <%= render "button", label: t("#{cc}.open_account"), url: super_admin_account_path(@account), variant: :secondary, extra: "h-9" %>
    <%= render "button", label: t("#{cc}.open_billing"), url: super_admin_billing_path, variant: :secondary, extra: "h-9" %>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <%= render "card", title: t("#{cc}.plan_and_limits") do %>
      <% if sub %>
        <dl class="divide-y divide-n-weak">
          <% [[:plan, sub[:plan]], [:state, t("#{cc}.state.#{sub[:state]}")],
              [:trial_ends_at, sub[:trial_ends_at]&.utc&.strftime("%Y-%m-%d")], [:paid_until, sub[:paid_until]&.utc&.strftime("%Y-%m-%d")],
              [:seats, "#{sub[:seats_used]} / #{sub[:seat_limit]}"], [:currency, sub[:currency]],
              [:purge_after, sub[:purge_after]&.utc&.strftime("%Y-%m-%d")]].each do |key, value| %>
            <div class="flex justify-between gap-4 px-5 py-2.5 text-body-main">
              <dt class="text-n-slate-11"><%= t("#{cc}.field.#{key}") %></dt>
              <dd class="text-end text-n-slate-12"><%= value.presence || "–" %></dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <p class="px-5 py-4 text-body-main text-n-slate-11"><%= t("#{cc}.no_subscription") %></p>
      <% end %>
    <% end %>

    <%= render "card", title: t("#{cc}.usage") do %>
      <dl class="divide-y divide-n-weak">
        <div class="flex justify-between gap-4 px-5 py-2.5 text-body-main">
          <dt class="text-n-slate-11"><%= t("#{cc}.col.conversations_30d") %></dt>
          <dd class="tabular-nums text-n-slate-12"><%= number_with_delimiter(@detail[:conversations_30d]) %></dd>
        </div>
        <% fu = @detail[:fair_use] %>
        <div class="flex justify-between gap-4 px-5 py-2.5 text-body-main">
          <dt class="text-n-slate-11"><%= t("#{cc}.fair_use") %></dt>
          <dd class="tabular-nums text-n-slate-12">
            <%= fu.is_a?(Hash) && fu["allowance"].to_i.positive? ? "#{number_with_delimiter(fu["used"].to_i)} / #{number_with_delimiter(fu["allowance"].to_i)} (#{fu["month"]})" : "–" %>
          </dd>
        </div>
      </dl>
    <% end %>
  </div>

  <%= render "card", title: t("#{cc}.hold_title") do %>
    <div class="px-5 py-4 space-y-2 text-body-main">
      <% held = sub && sub[:held_at] %>
      <p class="m-0 text-n-slate-11">
        <%= held ? t("#{cc}.held_since", at: sub[:held_at].utc.strftime("%Y-%m-%d %H:%M"), reason: sub[:held_reason]) : t("#{cc}.hold_hint") %>
      </p>
      <%= form_with url: (held ? super_admin_tolzar_cc_workspace_release_path(@account) : super_admin_tolzar_cc_workspace_hold_path(@account)),
                    method: :post, class: "flex flex-wrap gap-2 items-end" do %>
        <div>
          <%= label_tag :confirm, t("#{cc}.type_name", name: @account.name), class: "text-label-small" %>
          <%= text_field_tag :confirm, nil, autocomplete: "off", class: ui(:input, "min-h-9 w-56") %>
        </div>
        <div>
          <%= label_tag :reason, t("#{cc}.people_reason"), class: "text-label-small" %>
          <%= text_field_tag :reason, nil, maxlength: 300, class: ui(:input, "min-h-9 w-72") %>
        </div>
        <%= render "button", label: t("#{cc}.#{held ? 'resume' : 'hold'}"), type: "submit", variant: (held ? :primary : :danger), extra: "h-9" %>
      <% end %>
    </div>
  <% end %>

  <% ai = @detail[:ai] %>
  <%= render "card", title: t("#{cc}.ai") do %>
    <% if ai.nil? %>
      <p class="px-5 py-4 text-body-main text-n-slate-11"><%= t("#{cc}.ai_unknown") %></p>
    <% else %>
      <div class="flex flex-wrap items-center gap-2 px-5 py-3 text-body-main">
        <span class="text-n-slate-11"><%= t("#{cc}.kill_switch") %></span>
        <%= render "badge", label: t("#{cc}.#{ai[:kill_switch_on] ? 'kill_on' : 'kill_off'}"), tone: (ai[:kill_switch_on] ? :danger : :neutral) %>
        <span class="ms-4 text-n-slate-11"><%= t("#{cc}.agents") %></span>
        <% if ai[:agents].empty? %>
          <span class="text-n-slate-11">–</span>
        <% else %>
          <% ai[:agents].each do |agent| %>
            <%= render "badge", label: [agent[:name], agent[:status].presence].compact.join(" · "), tone: :info %>
          <% end %>
        <% end %>
      </div>
      <p class="border-t border-n-weak px-5 py-2 text-label-small text-n-slate-11"><%= t("#{cc}.ai_read_only") %></p>
    <% end %>
  <% end %>

  <%= render "card", title: t("#{cc}.inboxes"), count: @detail[:inboxes].size do %>
    <% if @detail[:inboxes].empty? %>
      <p class="px-5 py-4 text-body-main text-n-slate-11"><%= t("#{cc}.none") %></p>
    <% else %>
      <ul class="divide-y divide-n-weak">
        <% @detail[:inboxes].each do |inbox| %>
          <% mode = ai && ai[:inbox_modes][inbox[:id].to_s].presence %>
          <li class="flex items-center justify-between gap-4 px-5 py-2.5 text-body-main">
            <span class="text-n-slate-12"><%= inbox[:name] %></span>
            <span class="flex items-center gap-2">
              <% if ai %>
                <%= render "badge", label: t("#{cc}.mode.#{mode == 'live' ? 'live' : 'shadow'}"), tone: (mode == "live" ? :success : :warning) %>
              <% end %>
              <span class="font-mono text-xs text-n-slate-11"><%= inbox[:channel] %> · #<%= inbox[:id] %></span>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= render "card", title: t("#{cc}.brain_audit"), collapsible: true do %>
    <% if @detail[:brain_audit].nil? %>
      <p class="px-5 py-4 text-body-main text-n-slate-11"><%= t("#{cc}.ai_unknown") %></p>
    <% elsif @detail[:brain_audit].empty? %>
      <p class="px-5 py-4 text-body-main text-n-slate-11"><%= t("#{cc}.none") %></p>
    <% else %>
      <ul class="divide-y divide-n-weak">
        <% @detail[:brain_audit].each do |e| %>
          <li class="grid grid-cols-[11rem_1fr_1fr] gap-3 px-5 py-2 text-xs">
            <span class="font-mono text-n-slate-11"><%= e[:at] %></span>
            <span class="text-n-slate-12"><%= e[:actor] %></span>
            <span class="font-mono text-n-slate-12"><%= e[:action] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= render "card", title: t("#{cc}.members"), count: @detail[:members].size do %>
    <%= render "super_admin/tolzar_control_center/people_table", rows: @detail[:members].map { |m| m.merge(roles: [{ role: m[:role] }]) } %>
  <% end %>
<% end %>
